[Unit]
Description=t@sk4ce setup mode (hotspot + captive portal)
After=network.target tskfrce-wifi-helper.service
Before=docker.service

[Service]
Type=simple
# TODO: call backend to get box_id, setup_password, country
# For now, stub that will be filled by install.sh
ExecStart=/usr/local/bin/tskfrce-setup-mode.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment="BOX_ID=%i"

[Install]
WantedBy=multi-user.target
