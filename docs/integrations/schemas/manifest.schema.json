{
  "$defs": {
    "SettingField": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z_]{1,32}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 60,
          "title": "Label",
          "type": "string"
        },
        "options": {
          "items": {
            "maxLength": 100,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Options",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "text",
            "username",
            "number",
            "select"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "title": "SettingField",
      "type": "object"
    },
    "WidgetDecl": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "surface": {
          "enum": [
            "parent",
            "kid"
          ],
          "title": "Surface",
          "type": "string"
        },
        "title": {
          "maxLength": 40,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "surface",
        "title"
      ],
      "title": "WidgetDecl",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_url": {
      "title": "Base Url",
      "type": "string"
    },
    "description": {
      "maxLength": 300,
      "title": "Description",
      "type": "string"
    },
    "developer": {
      "maxLength": 60,
      "title": "Developer",
      "type": "string"
    },
    "icon": {
      "pattern": "^[a-z0-9_]{1,40}$",
      "title": "Icon",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,39}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 40,
      "title": "Name",
      "type": "string"
    },
    "permissions": {
      "items": {
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "poll_seconds": {
      "anyOf": [
        {
          "maximum": 86400,
          "minimum": 60,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Poll Seconds"
    },
    "protocol": {
      "const": "v1",
      "title": "Protocol",
      "type": "string"
    },
    "settings": {
      "items": {
        "$ref": "#/$defs/SettingField"
      },
      "maxItems": 10,
      "title": "Settings",
      "type": "array"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "widgets": {
      "items": {
        "$ref": "#/$defs/WidgetDecl"
      },
      "maxItems": 6,
      "title": "Widgets",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "developer",
    "description",
    "icon",
    "version",
    "protocol",
    "base_url"
  ],
  "title": "Manifest",
  "type": "object"
}
