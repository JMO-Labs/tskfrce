      "required": [
        "idempotency_key",
        "ref",
        "name",
        "price"
      ],
      "title": "RewardUpsert",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "chore.complete": "#/$defs/ChoreComplete",
      "message.parents": "#/$defs/MessageParents",
      "request.decide": "#/$defs/RequestDecide",
      "reward.remove": "#/$defs/RewardRemove",
      "reward.upsert": "#/$defs/RewardUpsert"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ChoreComplete"
    },
    {
      "$ref": "#/$defs/RewardUpsert"
    },
    {
      "$ref": "#/$defs/RewardRemove"
    },
    {
      "$ref": "#/$defs/MessageParents"
    },
    {
      "$ref": "#/$defs/RequestDecide"
    }
  ]
}
