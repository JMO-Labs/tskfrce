# t@sk4ce Environment Configuration
# Copy this file to .env and customize the values for your setup

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
# Default: sqlite in DATA_DIR (./data/task4ce.db)
# DATABASE_URL=
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/task4ce

# Secrets are generated on first boot into DATA_DIR/secrets.json.
# Optionally override: SECRET_KEY, JWT_SECRET_KEY.
# INTERNAL_TOKEN is required here (backend and blocker must share it); scripts/start.sh generates one.
# INTERNAL_TOKEN=

# Public address of this box, used in password reset links and the kid portal redirect
# BOX_URL=http://192.168.1.20:3000

# Address phones use to reach the ntfy alerts service (must be one the phone can reach).
# Used by both ntfy and the backend QR code so they cannot diverge.
# NTFY_PUBLIC_URL=http://192.168.1.20:2586
# Host port for ntfy; when NTFY_PUBLIC_URL is unset the phone URL uses BOX_URL's host + this port.
# NTFY_PORT=0.0.0.0:2586

# Kids' phone alerts are relayed through a public ntfy server as generic messages (no names or chores).
# Default is https://ntfy.sh. Set it empty to turn this off, or point it at your own ntfy server.
# NTFY_UPSTREAM_URL=https://ntfy.sh
# Only needed if your ntfy server requires a login token. Keep this file private (mode 600).
# NTFY_UPSTREAM_TOKEN=

# Sticker code that lets the first parent claim this box (10 letters/digits, dashes ignored).
# Written by scripts/enable-hostname.sh when CLAIM_CODE is set; stops working once a parent exists.
# CLAIM_CODE=

# HTTPS hostname (written by scripts/enable-hostname.sh; do not edit by hand)
# BOX_ID=        # 6-char code from the box sticker
# BOX_SECRET=    # secret printed once by registry/scripts/new-box.sh
# EDGE_TOKEN=    # random token proving to the frontend that a request came via the edge proxy
# Where the edge proxy finds the frontend/ntfy on the host (match FRONTEND_PORT/NTFY_PORT if changed)
# FRONTEND_UPSTREAM=127.0.0.1:3000
# NTFY_UPSTREAM=127.0.0.1:2586

# Service Ports
BACKEND_PORT=127.0.0.1:8000
FRONTEND_PORT=0.0.0.0:3000

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=t@sk4ce

# CORS Configuration
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.95:3000
# Comma-separated list of trusted hosts
TRUSTED_HOSTS=localhost,127.0.0.1,192.168.1.95,task4ce-backend

# Node.js Environment
NODE_ENV=development

# PostgreSQL (optional, for production)
# POSTGRES_PASSWORD=change-me