{
  "name": "task4ce-frontend",
  "version": "2.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:custom": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "start:next": "NODE_OPTIONS='--require ./relay-preload.js' next start",
    "test:standalone": "next build && node scripts/standalone-relay-check.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/dates": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.6.2",
    "axios": "^1.21.0",
    "dayjs": "^1.11.18",
    "http-proxy-middleware": "^4.2.1",
    "material-symbols": "^0.48.2",
    "next": "^16.4.4",
    "postcss": "^8.5.32",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "simple-icons": "^16.36.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.4.4",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.5.2"
  },
  "overrides": {
    "glob": "^10.3.10",
    "next": {
      "postcss": "$postcss"
    },
    "minimatch": "^11.0.4"
  }
}
