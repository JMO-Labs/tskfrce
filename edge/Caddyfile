{
	auto_https off
	admin localhost:2019
}

# Hotspot captive portal (10.42.0.1)
# This site is only reachable from hotspot clients (10.42.0.0/24)
http://10.42.0.1 {
	# Probe URL handlers: redirect to setup page
	@probes path /hotspot-detect.html /generate_204 /connecttest.txt /ncsi.txt
	redir @probes http://10.42.0.1/setup 302

	# Setup page: reverse-proxy to frontend
	@setup_page path /setup
	reverse_proxy @setup_page {$FRONTEND_UPSTREAM:127.0.0.1:3000} {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}

	# Setup API endpoints: reverse-proxy to backend
	@setup_api path /api/v1/network/wifi/setup/*
	reverse_proxy @setup_api 127.0.0.1:8000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}

	# Everything else: redirect to setup
	redir / http://10.42.0.1/setup 302
}

https://{$BOX_ID}.{$BASE_DOMAIN}:443 {
	tls /data/lego/certificates/{$BOX_ID}.{$BASE_DOMAIN}.crt /data/lego/certificates/{$BOX_ID}.{$BASE_DOMAIN}.key
	reverse_proxy {$FRONTEND_UPSTREAM:127.0.0.1:3000} {
		header_up X-Real-IP {remote_host}
		header_up X-Edge-Token {$EDGE_TOKEN}
	}
}
