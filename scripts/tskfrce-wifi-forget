#!/bin/sh
# Forget the currently saved Wi-Fi network.
# Used by factory reset (PR 2) to clear Wi-Fi credentials.

set -e

# Call the backend API to forget the Wi-Fi network.
# This is typically invoked after the reset service.
curl -s -X POST http://127.0.0.1:8000/api/v1/network/wifi/forget \
  -H "Authorization: Bearer internal" \
  -w "\n" || echo "Wi-Fi forget request sent (may fail if not online)"
